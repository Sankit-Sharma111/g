# Never put real keys in GitHub. Add these as private environment variables on your host.
TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
GEMINI_API_KEY=put_your_gemini_api_key_here

# Your numeric Telegram user ID. Only this account can use /ai_on and /ai_off.
ADMIN_USER_ID=123456789

# Optional settings
GEMINI_MODEL=gemini-2.5-flash
SYSTEM_PROMPT=You are a friendly AI assistant. Reply naturally in the same language as the user. Be concise and never pretend to be human.
